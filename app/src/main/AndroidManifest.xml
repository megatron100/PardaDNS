<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required for VpnService tunnel -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Required to keep PardaVpnService alive in the background -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Required on API 34+ for foregroundServiceType="specialUse" -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Keeps CPU running while the DNS tunnel is active so the read loop doesn't starve -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Required to prompt the user to exempt the app from Doze battery optimizations -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Required for ConnectivityManager.registerDefaultNetworkCallback (network change detection) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
      Required on API 30+ to enumerate all installed apps in the App Filter screen.
      Android 11+ restricts package visibility by default; without this permission
      queryIntentActivities only returns a small, filtered subset.
      VPN apps (NetGuard, RethinkDNS, etc.) all require this for per-app tunnel control.
    -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- Pro: connect on device start and re-arm schedule alarms after reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Pro: on-time schedule changes. User-granted on Android 12+; we fall back to inexact alarms. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <application
        android:name=".PardaDnsApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PardaDNS">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.PardaDNS">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          BIND_VPN_SERVICE restricts binding to system components only.
          The <intent-filter> with android.net.VpnService is required for
          Android to recognise this as a real VPN service.
        -->
        <service
            android:name=".service.PardaVpnService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false"
            tools:targetApi="34"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <!-- Declares support for always-on VPN and disallows lockdown by default -->
            <meta-data
                android:name="android.net.VpnService.SUPPORTS_ALWAYS_ON"
                android:value="true" />
        </service>

        <service
            android:name=".service.PardaTileService"
            android:label="@string/tile_label"
            android:icon="@drawable/ic_tile_shield"
            android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Schedule boundaries and pause expiry (our own explicit alarms only). -->
        <receiver
            android:name=".service.ProtectionAlarmReceiver"
            android:exported="false" />

        <!-- Exported only for protected system broadcasts; ignores everything else. -->
        <receiver
            android:name=".service.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>